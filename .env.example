# Copie para .env e ajuste.
DATABASE_URL=postgresql+psycopg://partidas:partidas@localhost:5432/partidas
# Gere uma chave forte, ex.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-esta-chave-em-producao
TIMEZONE=America/Sao_Paulo
DEBUG=false
# Deixe true quando o site estiver atrás de HTTPS
COOKIE_SEGURO=false
